                <tr><td><code>minDecodedSize(bytes, msg?)</code></td><td>Min decoded size</td></tr>
                <tr><td><code>maxDecodedSize(bytes, msg?)</code></td><td>Max decoded size</td></tr>
                <tr><td><code>mimeType(type, msg?)</code></td><td>Exact data URL MIME type</td></tr>
                <tr><td><code>mimeTypePattern(pattern, msg?)</code></td><td>MIME pattern</td></tr>
                <tr><td><code>image(msg?)</code></td><td>Shortcut: <code>image/*</code></td></tr>
                <tr><td><code>pdf(msg?)</code></td><td>Shortcut: <code>application/pdf</code></td></tr>
                <tr><td><code>json(msg?)</code></td><td>Decoded must be valid JSON</td></tr>
                <tr><td><code>dataUrl(msg?)</code></td><td>Must be data URL</td></tr>
              </tbody>
            </table>
          </div>
        </section>

        <!-- ── Composition ── -->
        <section id="core-composition" class="doc-section">
          <div class="section-accent"></div>
          <h2><span class="section-icon">&#9679;</span> Union / Intersection / Discriminated Union / Lazy</h2>
          <pre><code>{`// Union — first schema that matches wins
k.union([k.string(), k.number()])

// Discriminated union — O(1) dispatch by a key; map keys are the discriminator values
k.discriminatedUnion('type', {
  cat: k.object({ type: k.literal('cat'), meow: k.boolean() }),
  dog: k.object({ type: k.literal('dog'), bark: k.boolean() }),
})

// Intersection — ALL schemas must match (merge objects)
k.intersection([
  k.object({ id: k.number() }),
  k.object({ name: k.string() })
])

// Lazy — deferred resolution for recursive types.
// The optional name becomes the JSON Schema $anchor of the recursion.
const categorySchema = k.lazy(() =>
  k.object({
    name: k.string(),
    subcategories: k.array(categorySchema)
  }),
  'Category'
);`}</code></pre>
        </section>

        <!-- ── BigInt / Set / Map / Promise / Primitives ── -->
        <section id="core-collections" class="doc-section">
          <div class="section-accent"></div>
          <h2><span class="section-icon">&#9679;</span> BigInt / Set / Map / Promise / Primitives</h2>
          <pre><code>{`k.bigint()                 // min, max, positive, negative, nonnegative, nonpositive,
                           // between, greaterThan, lessThan, multipleOf, equals,
                           // notEqual, oneOf, notOneOf

k.set(k.number())          // Set<number>        .minSize(n) .maxSize(n) .nonempty()
k.map(k.string(), k.number()) // Map<string, number> .minSize(n) .maxSize(n) .nonempty()
k.promise(k.string())      // input must be a Promise; the resolved value is validated

k.nan()        // only NaN
k.null()       // only null
k.undefined()  // only undefined (inside an object: key must be absent)
k.void()       // null or undefined`}</code></pre>
        </section>

        <!-- ── Extras ── -->
        <section id="core-extras" class="doc-section">
          <div class="section-accent"></div>
          <h2><span class="section-icon">&#9679;</span> Literal / Enum / Tuple / Record / Any / Unknown / Never</h2>
          <pre><code>{`k.literal('active')               // Exact value (===)
k.enum(['active', 'inactive'])    // String union
k.tuple([k.number(), k.string()]) // Fixed-length typed array
k.record(k.number())              // Record<string, number>
k.any()                           // Accepts everything
k.unknown()                       // Accepts everything (forces narrowing)
k.never()                         // Never matches`}</code></pre>
        </section>

        <!-- ── Custom ── -->
        <section id="core-custom" class="doc-section">
          <div class="section-accent"></div>
          <h2><span class="section-icon">&#9679;</span> Custom &mdash; <code>k.custom&lt;T&gt;(validator)</code></h2>
          <pre><code>{`const positiveEven = k.custom<number>((value, path) => {
  if (typeof value !== 'number')
    return [{ path, message: 'Must be number' }];
  if (value <= 0 || value % 2 !== 0)
    return [{ path, message: 'Must be positive even' }];
  return value;
});

// Add refinement
positiveEven.refine((v) => v < 1000, 'Must be less than 1000');`}</code></pre>
        </section>

        <!-- ── Modifiers / Coerce / Preprocess ── -->
        <section id="core-modifiers" class="doc-section">
          <div class="section-accent"></div>
          <h2><span class="section-icon">&#9679;</span> Modifiers / Coercion / Preprocess</h2>

          <h3>Coercion &mdash; <code>k.coerce</code></h3>
          <p>Auto-converts types before validating:</p>
          <pre><code>{`k.coerce.number()   // "42" → 42, true → 1, false → 0
k.coerce.boolean()  // "true"/"1"/"yes" → true, "false"/"0"/"no" → false
k.coerce.string()   // 42 → "42", true → "true", null → ""
k.coerce.date()     // ISO string → Date, timestamp → Date

// Every method of the target schema is available:
k.coerce.number().positive().integer()
k.coerce.boolean().isTrue()
k.coerce.string().minLength(3).email()
k.coerce.date().isFuture()`}</code></pre>

          <h3>Preprocess &mdash; <code>k.preprocess(fn, schema)</code></h3>
          <pre><code>{`k.preprocess(
  (val) => typeof val === 'string' ? val.trim().toLowerCase() : val,
  k.string().email()
)`}</code></pre>

          <h3>Error Utilities</h3>
          <pre><code>{`import { createIssue, issues, mergeIssues, isIssueArray, describeReceived, KataxError } from 'katax-core';

createIssue(['field'], 'error message');   // Issue object
issues(['field'], 'error message');         // Issue[]
mergeIssues(arr1, arr2);                    // Merge issue arrays
isIssueArray(value);                        // Type guard
describeReceived(value);                    // 'null' | 'undefined' | 'array' | typeof value

// KataxError is thrown by parse()/parseAsync(); e.issues has every issue
throw new KataxError(result.issues);

// KataxAsyncValidationRequiredError: parse()/safeParse() on a schema with async validators`}</code></pre>
        </section>

        <!-- ── Async Validation ── -->
        <section id="core-async" class="doc-section">
          <div class="section-accent"></div>
          <h2><span class="section-icon">&#9679;</span> Async Validation</h2>
          <pre><code>{`const usernameSchema = k.string().minLength(3).asyncRefine(async (value, path) => {
  const exists = await usersRepo.existsByUsername(value);
  return exists ? [{ path, message: 'Already taken' }] : [];
});

const result = await usernameSchema.safeParseAsync(input);

// Also available:
await schema.parseAsync(input);      // Throws KataxError
await schema.isValidAsync(input);    // { valid, issues }

// parse()/safeParse() throw KataxAsyncValidationRequiredError on schemas with async
// validators. validateSchema() picks sync or async for you:
import { validateSchema } from 'katax-core';
const r = await validateSchema(usernameSchema, req.body.username);`}</code></pre>
        </section>

        <!-- ── JSON Schema / OpenAPI ── -->
        <section id="core-jsonschema" class="doc-section">
          <div class="section-accent"></div>
          <h2><span class="section-icon">&#9679;</span> JSON Schema &amp; OpenAPI &mdash; <code>toJsonSchema()</code></h2>
          <p>Every schema generates <strong>JSON Schema Draft 2020-12</strong> that matches what <code>parse()</code> accepts: chained rules, nullability and optional keys included. Use it in <strong>OpenAPI 3.1</strong> documents (Swagger UI, Redoc). OpenAPI 3.0 uses an older JSON Schema subset and won't accept <code>type</code> arrays, <code>const</code> or <code>prefixItems</code>.</p>
          <pre><code>{`const schema = k.object({
  name: k.string().minLength(2).describe("User's full name"),
  age: k.number().integer().min(18),
  nickname: k.string().nullish(),
  role: k.enum(['admin', 'user']).default('user'),
});

schema.toJsonSchema();
// {
//   type: "object",
//   properties: {
//     name: { type: "string", minLength: 2, description: "User's full name" },
//     age: { type: "integer", minimum: 18 },
//     nickname: { type: ["string", "null"] },
//     role: { type: "string", enum: ["admin", "user"], default: "user" }
//   },
//   required: ["name", "age"]
// }`}</code></pre>
          <div class="table-wrapper">
            <table>
              <thead><tr><th style="width:35%">Schema</th><th>JSON Schema</th></tr></thead>
              <tbody>
                <tr><td><code>.optional()</code> / <code>.default(v)</code></td><td>Key not in <code>required</code> (<code>default</code> also adds <code>default: v</code>)</td></tr>
                <tr><td><code>.nullable()</code></td><td><code>type: ["T", "null"]</code>, or <code>anyOf</code> with <code>null</code> for enum/literal/union</td></tr>
                <tr><td><code>.nullish()</code></td><td>Like <code>.nullable()</code> and key not required</td></tr>
                <tr><td><code>k.number().integer()</code></td><td><code>type: "integer"</code></td></tr>
                <tr><td><code>.positive()</code> / <code>.greaterThan(n)</code></td><td><code>exclusiveMinimum</code></td></tr>
                <tr><td>String rules (<code>regex</code>, <code>startsWith</code>...)</td><td><code>pattern</code>; several are combined with <code>allOf</code></td></tr>
                <tr><td><code>k.object().strict()</code></td><td><code>additionalProperties: false</code></td></tr>
                <tr><td><code>k.union()</code> / <code>k.intersection()</code></td><td><code>anyOf</code> / <code>allOf</code></td></tr>
                <tr><td><code>k.discriminatedUnion()</code></td><td><code>oneOf</code>; each branch pins the key with <code>const</code></td></tr>
                <tr><td><code>k.tuple()</code></td><td><code>prefixItems</code> + <code>items: false</code></td></tr>
                <tr><td>Recursive <code>k.lazy(fn, 'Name')</code></td><td><code>$anchor: "Name"</code> and <code>$ref: "#Name"</code></td></tr>
              </tbody>
            </table>
          </div>
          <p>Runtime-only rules (not representable in JSON Schema): <code>refine</code>, <code>asyncRefine</code>, <code>custom</code>, transforms, date comparisons, email domain rules, file/base64 size and MIME checks, regex flags.</p>
        </section>

        <!-- ═══ KATAX-SERVICE-MANAGER ═══ -->

