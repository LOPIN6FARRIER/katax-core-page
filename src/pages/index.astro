                <tr><td><code>isPast(msg?)</code></td><td>Must be in the past</td></tr>
                <tr><td><code>format(formatStr, msg?)</code></td><td>Must match format</td></tr>
                <tr><td><code>isDateOnly(msg?)</code></td><td>Date only (YYYY-MM-DD)</td></tr>
                <tr><td><code>hasTime(msg?)</code></td><td>Must include time</td></tr>
