        <!-- ── Database ── -->
        <section id="sm-db" class="doc-section">
          <div class="section-accent"></div>
          <h2><span class="section-icon">&#9679;</span> Database Service</h2>
          <p>Supports PostgreSQL, MySQL, MongoDB, and Redis with typed connections and configurable pool.</p>

          <h3>Setup</h3>
          <pre><code>{`// PostgreSQL / MySQL
const db = await katax.database({
  name: 'main', type: 'postgresql',
  connection: { host: 'localhost', port: 5432, database: 'myapp', user: 'admin', password: 'secret' },
  pool: { max: 10, min: 2 },
});

// MongoDB
const mongo = await katax.database({
  name: 'analytics', type: 'mongodb',
  connection: { host: 'localhost', port: 27017, database: 'analytics' },
});

// Redis
const redis = await katax.database({
  name: 'cache', type: 'redis',
  connection: { host: '127.0.0.1', port: 6379 },
});`}</code></pre>

          <h3>Typed Access</h3>
          <p><code>katax.database()</code> is typed by <code>type</code>: <code>ISqlDatabase</code> (postgresql/mysql), <code>IMongoDatabase</code> or <code>IRedisDatabase</code> (<code>| null</code> with <code>required: false</code>). <code>katax.db(name)</code> returns the generic <code>IDatabaseService</code>, so narrow it:</p>
          <pre><code>{`import { katax, DatabaseService, type ISqlDatabase, type IRedisDatabase } from 'katax-service-manager';

// Compile-time cast
const sql = katax.db('main') as ISqlDatabase;
const users = await sql.query<User[]>('SELECT * FROM users WHERE id = $1', [userId]);

// Or the DatabaseService helpers (also check the type at runtime)
const db = katax.db('main') as DatabaseService;
db.asSql()    // ISqlDatabase — query<T>(sql, params?), getClient(), close()
db.asMongo()  // IMongoDatabase — getClient(), close()
db.asRedis()  // IRedisDatabase — redis(...args), close()

const redis = katax.db('cache') as IRedisDatabase;
await redis.redis('SET', 'key', 'value', 'EX', '60');   // RESP2 replies`}</code></pre>
        </section>

        <!-- ── Cache ── -->
        <section id="sm-cache" class="doc-section">
          <div class="section-accent"></div>
          <h2><span class="section-icon">&#9679;</span> Cache Service</h2>
          <p>High-level Redis wrapper with automatic JSON serialization.</p>
          <pre><code>{`const cache = katax.cache('cache'); // Redis connection name`}</code></pre>
          <div class="table-wrapper">
            <table>
              <thead><tr><th style="width:30%">Method</th><th>Description</th></tr></thead>
              <tbody>
                <tr><td><code>get&lt;T&gt;(key)</code></td><td>Get value (auto-deserializes JSON)</td></tr>
                <tr><td><code>set(key, value, ttl?)</code></td><td>Store with optional TTL (seconds)</td></tr>
                <tr><td><code>del(key)</code></td><td>Delete single key</td></tr>
                <tr><td><code>delMany(keys[])</code></td><td>Delete multiple keys</td></tr>
                <tr><td><code>exists(key)</code></td><td>Check if key exists</td></tr>
                <tr><td><code>ttl(key)</code></td><td>Remaining TTL</td></tr>
                <tr><td><code>expire(key, seconds)</code></td><td>Set expiration on existing key</td></tr>
                <tr><td><code>incr(key)</code></td><td>Increment by 1</td></tr>
                <tr><td><code>incrBy(key, n)</code></td><td>Increment by n</td></tr>
                <tr><td><code>decr(key)</code></td><td>Decrement by 1</td></tr>
                <tr><td><code>mget&lt;T&gt;(keys[])</code></td><td>Get multiple values</td></tr>
                <tr><td><code>mset(entries[])</code></td><td>Store multiple [key, value] pairs</td></tr>
                <tr><td><code>clear(pattern?)</code></td><td>Delete by pattern</td></tr>
                <tr><td><code>stats()</code></td><td>Redis INFO statistics</td></tr>
              </tbody>
            </table>
          </div>
          <pre><code>{`await cache.set('user:123', userData, 3600);
const user = await cache.get<User>('user:123');
await cache.del('user:123');
await cache.incr('page:views');
await cache.mset([['k1', v1], ['k2', v2]]);`}</code></pre>
        </section>

        <!-- ── Logger ── -->
        <section id="sm-logger" class="doc-section">
          <div class="section-accent"></div>
          <h2><span class="section-icon">&#9679;</span> Logger &amp; Transports</h2>
          <p>Pino-based structured logging with WebSocket broadcast and transport system.</p>

          <pre><code>{`// All log levels
katax.logger.trace('trace message');
katax.logger.debug('debug message');
katax.logger.info({ message: 'Server started', port: 3000 });
katax.logger.warn({ message: 'High memory', percent: 85 });
katax.logger.error({ message: 'Query failed', error: err });
katax.logger.fatal('fatal error');

// Child logger with context
const log = katax.logger.child({ service: 'payments', userId: 123 });
log.info({ message: 'Payment processed' });

// Routing options go in the second argument (never sent to transports)
katax.logger.info({ message: 'Trade executed', amount: 100 }, { broadcast: true, room: 'admins' });
katax.logger.error('Payment failed', { persist: true, skipTelegram: true });`}</code></pre>

          <h3>Transports</h3>
          <pre><code>{`import { RedisTransport, TelegramTransport, CallbackTransport } from 'katax-service-manager';

// Redis transport
const redisTransport = new RedisTransport(katax.db('cache') as IRedisDatabase, {
  streamKey: 'katax:logs', name: 'redis-errors',
});
redisTransport.filter = (log) => log.level === 'error' || log.persist === true;
katax.logger.addTransport(redisTransport);

// Telegram
const telegram = new TelegramTransport({
  botToken: katax.envRequired('TELEGRAM_BOT_TOKEN'),
  chatId: katax.envRequired('TELEGRAM_ALERTS_CHAT_ID'),
  levels: ['error', 'fatal'],
  includePersist: true, parseMode: 'Markdown',
});
katax.logger.addTransport(telegram);

// Management
katax.logger.removeTransport('telegram-errors');
await katax.logger.closeTransports();`}</code></pre>
        </section>

        <!-- ── WebSocket ── -->
        <section id="sm-ws" class="doc-section">
          <div class="section-accent"></div>
          <h2><span class="section-icon">&#9679;</span> WebSocket (Socket.IO)</h2>
          <pre><code>{`// Shared with Express (preferred)
const httpServer = createServer(app);
await katax.socket({
  name: 'main', httpServer,
  cors: { origin: '*' },
});

// Standalone with auth
await katax.socket({
  name: 'events', port: 3001,
  enableAuth: true,
  authValidator: async (token) => token === katax.envRequired('WS_SECRET'),
});

const ws = katax.ws('main');`}</code></pre>

          <div class="table-wrapper">
            <table>
              <thead><tr><th style="width:30%">Method</th><th>Description</th></tr></thead>
              <tbody>
                <tr><td><code>emit(event, data, room?)</code></td><td>Emit event (optionally to room)</td></tr>
                <tr><td><code>emitToRoom(room, event, data)</code></td><td>Emit to specific room</td></tr>
                <tr><td><code>on(event, handler)</code></td><td>Listen for events</td></tr>
                <tr><td><code>onConnection(handler)</code></td><td>Handle new connections</td></tr>
                <tr><td><code>hasRoomListeners(room)</code></td><td>Has listeners in room?</td></tr>
                <tr><td><code>getRoomClientsCount(room)</code></td><td>Clients in room</td></tr>
                <tr><td><code>hasConnectedClients()</code></td><td>Any clients connected?</td></tr>
                <tr><td><code>getConnectedClientsCount()</code></td><td>Total connected clients</td></tr>
                <tr><td><code>close()</code></td><td>Close WebSocket server</td></tr>
                <tr><td><code>getServer()</code></td><td>Underlying Socket.IO Server (on the class, not on the <code>IWebSocketService</code> type: cast to use it)</td></tr>
              </tbody>
            </table>
          </div>

          <pre><code>{`ws.onConnection((socket) => {
  socket.on('message', (data) => { ... });
  socket.emit('welcome', { status: 'connected' });
  socket.join('room-123');
  socket.leave('room-123');
});`}</code></pre>
        </section>

        <!-- ── Cron ── -->
        <section id="sm-cron" class="doc-section">
          <div class="section-accent"></div>
          <h2><span class="section-icon">&#9679;</span> Cron Service</h2>
          <p>Loads <code>node-cron</code> on first use. <code>katax.cron()</code> returns a Promise: await it to catch invalid schedules. <code>katax.cronService</code> is available after the first <code>katax.cron()</code>.</p>
          <pre><code>{`await katax.cron({
  name: 'process-assets',
  schedule: '*/10 6-15 * * 1-5',
  task: processAssets,
  runOnInit: katax.isProd,
  timezone: 'America/Mexico_City',
  enabled: true,
});

// Advanced management
katax.cronService.getJobs();
await katax.cronService.startJob('process-assets');
katax.cronService.stopJob('process-assets');
katax.cronService.removeJob('process-assets');
katax.cronService.stopAll();`}</code></pre>
        </section>

        <!-- ── Registry / Health ── -->
        <section id="sm-registry" class="doc-section">
          <div class="section-accent"></div>
          <h2><span class="section-icon">&#9679;</span> Registry &amp; Health Check</h2>

          <pre><code>{`await katax.init({
  registry: {
    url: 'https://dashboard.example.com/api/services',
    apiKey: katax.env('REGISTRY_KEY'),
    heartbeatInterval: 30000,
    requestTimeoutMs: 5000,
    retryAttempts: 2,
    retryBaseDelayMs: 300,
    metadata: { env: katax.nodeEnv, region: 'us-east' },
  },
});

// Or custom handler
registry: {
  handler: {
    register: async (info) => { ... },
    heartbeat: async (info) => { ... },
    unregister: async (payload) => { ... },
  }
}

katax.isRegistered;         // boolean
katax.getServiceInfo();     // ServiceInfo | null`}</code></pre>

          <h3>Health Check</h3>
          <pre><code>{`const health = await katax.healthCheck();
// { status: 'healthy' | 'degraded' | 'unhealthy',
//   services: { databases: {}, sockets: {}, cron: boolean },
//   timestamp: number }`}</code></pre>
        </section>

        <!-- ── Bridge / Heartbeat ── -->
        <section id="sm-bridge" class="doc-section">
          <div class="section-accent"></div>
          <h2><span class="section-icon">&#9679;</span> Redis Stream Bridge &amp; Heartbeat</h2>

          <h3>Stream Bridge</h3>
          <pre><code>{`const bridge = katax.bridge('cache', 'main', {
  appName: 'my-api',
  streamKey: 'katax:logs',
  group: 'katax-bridge-my-api',
  batchSize: 10,
  blockTimeout: 2000,
});
await bridge.start();
bridge.isRunning();
bridge.stop();`}</code></pre>

          <h3>Heartbeat</h3>
          <pre><code>{`// Managed (auto-cleanup on shutdown)
katax.heartbeat(
  { app: katax.appName, port: 3000, version: katax.version, intervalMs: 10000 },
  'cache', 'main',
);

// Manual helpers
import { registerProjectInRedis, startHeartbeat } from 'katax-service-manager';
await registerProjectInRedis(redisDb, { app: katax.appName, version: katax.version, port: PORT });
const hb = startHeartbeat(redisDb, { app: katax.appName, port: PORT, intervalMs: 10000 }, ws);
hb?.stop();`}</code></pre>
        </section>

        <!-- ── Bootstrap ── -->
        <section id="sm-bootstrap" class="doc-section">
          <div class="section-accent"></div>
          <h2><span class="section-icon">&#9679;</span> Bootstrap Template</h2>
          <pre><code>{`import { katax } from 'katax-service-manager';
import { createServer } from 'http';
import app from './app.js';

async function bootstrap(): Promise<void> {
  try {
    await katax.init({
      loadEnv: true,
      logger: { level: katax.env('LOG_LEVEL', 'info') as any, prettyPrint: katax.isDev, enableBroadcast: true },
    });

    await katax.database({
      name: 'main', type: 'postgresql',
      connection: {
        host: katax.envRequired('DB_HOST'),
        port: katax.env('DB_PORT', 5432),
        database: katax.envRequired('DB_NAME'),
        user: katax.envRequired('DB_USER'),
        password: katax.envRequired('DB_PASSWORD'),
      },
      pool: { max: 10, min: 2 },
    });

    await katax.database({
      name: 'cache', type: 'redis',
      connection: { host: katax.env('REDIS_HOST', '127.0.0.1'), port: 6379 },
    });

    const PORT = katax.env('PORT', '3000');
    const httpServer = createServer(app);
    await katax.socket({ name: 'main', httpServer, cors: { origin: '*' } });

    await katax.cron({ name: 'cleanup', schedule: '0 3 * * *', task: async () => { /* nightly */ } });

    httpServer.listen(PORT, () => {
      katax.logger.info({ message: 'Server running on http://localhost:' + PORT });
    });
    // SIGTERM/SIGINT are handled by katax (graceful shutdown)
  } catch (err) {
    console.error('Bootstrap failed:', err);
    process.exit(1);
  }
}

void bootstrap();`}</code></pre>
        </section>

        <!-- ═══ KATAX-CLI ═══ -->

        <section id="cli" class="doc-section">
          <div class="section-accent"></div>
          <h2><span class="section-icon">&#9679;</span> katax-cli</h2>
          <p>CLI for scaffolding Express + TypeScript APIs, generating CRUD/endpoints/repositories, OpenAPI docs, and managing VPS deployments with PM2.</p>

          <div class="cards">
            <article class="card">
              <h3>Scaffold <span>init</span></h3>
              <p>Complete Express + TypeScript project with interactive prompts for DB, auth, validation, Swagger, katax-service-manager, WebSocket and Redis. Installs dependencies.</p>
            </article>
            <article class="card">
              <h3>Generate <span>endpoint &amp; CRUD</span></h3>
              <p>Generates validators, controllers, handlers and routes (controllers start with sample data + TODOs). Nested resources supported. Auto-regenerates OpenAPI docs.</p>
            </article>
            <article class="card">
              <h3>Deploy <span>PM2</span></h3>
              <p>Full VPS deployment workflow: init (clone + PM2), update (pull + restart), rollback, logs, and status.</p>
            </article>
          </div>
        </section>

        <!-- ── CLI Commands ── -->
        <section id="cli-commands" class="doc-section">
          <div class="section-accent"></div>
          <h2><span class="section-icon">&#9679;</span> Commands</h2>

          <h3><code>katax init [project-name]</code></h3>
          <p>Scaffolds a complete Express + TypeScript + katax-core project.</p>
          <div class="table-wrapper">
            <table>
              <thead><tr><th style="width:25%">Flag</th><th>Description</th></tr></thead>
              <tbody>
                <tr><td><code>-f, --force</code></td><td>Use an existing directory (files are overwritten)</td></tr>
                <tr><td><code>--pm &lt;npm|pnpm&gt;</code></td><td>Default package manager in the prompt (default: pnpm)</td></tr>
                <tr><td><code>--ignore-scripts</code></td><td>Default answer: install with lifecycle scripts disabled</td></tr>
                <tr><td><code>--write-npmrc</code></td><td>Default answer: write <code>.npmrc</code> with <code>ignore-scripts=true</code></td></tr>
              </tbody>
            </table>
          </div>

          <h3><code>katax add endpoint &lt;name&gt;</code></h3>
          <p>Add a new endpoint with validator, controller, handler, and routes. HTTP methods, rate limiter and body fields are chosen in prompts; the route comes from the name (<code>admin/users</code> &rarr; <code>/api/admin/users</code>). The <code>-m</code> and <code>-p</code> flags are accepted but currently ignored.</p>

          <h3><code>katax generate crud &lt;resource-name&gt;</code></h3>
          <p>Aliases: <code>gen</code>, <code>g</code>. Generates CRUD endpoints: list, get by ID, create, update, delete.</p>
          <div class="table-wrapper">
            <table>
              <thead><tr><th style="width:25%">Flag</th><th>Description</th></tr></thead>
              <tbody>
                <tr><td><code>--no-auth</code></td><td>Default "no" for the auth prompt. Auth uses <code>authenticateToken</code> from <code>jwt.utils.ts</code> (JWT projects only)</td></tr>
              </tbody>
            </table>
          </div>

          <h3><code>katax generate repository &lt;name&gt;</code></h3>
          <p>Writes <code>src/api/&lt;name&gt;/&lt;name&gt;.repository.ts</code>: a class over a <code>katax.database()</code> connection (PostgreSQL, MySQL or MongoDB) with <code>findAll()</code>, <code>findById()</code>, <code>exists()</code>, <code>create()</code>, <code>update()</code>, <code>delete()</code>.</p>

          <h3><code>katax generate docs</code></h3>
          <p>Writes an OpenAPI 3.0 spec to <code>src/openapi.json</code> and Swagger UI at <code>/docs</code>. Run <code>katax fix docs</code> once so the build copies the spec to <code>dist/</code> for production.</p>
          <div class="table-wrapper">
            <table>
              <thead><tr><th style="width:25%">Flag</th><th>Description</th></tr></thead>
              <tbody>
                <tr><td><code>-f, --force</code></td><td>Force regeneration</td></tr>
                <tr><td><code>-o, --output &lt;path&gt;</code></td><td>Output path (default: src/openapi.json)</td></tr>
                <tr><td><code>-p, --port &lt;port&gt;</code></td><td>Server port</td></tr>
                <tr><td><code>-u, --url &lt;url&gt;</code></td><td>Production server URL</td></tr>
              </tbody>
            </table>
          </div>

          <h3><code>katax info</code></h3>
          <p>Aliases: <code>status</code>, <code>ls</code>. Shows project info, katax package versions (and available updates), and routes.</p>

          <h3>Deploy</h3>
          <pre><code>{`katax deploy init       # Initial PM2 setup (repo, branch, path, cluster, memory, env)
katax deploy update     # Pull, rebuild, restart
  -b, --branch <branch>
  --hard                # Hard reset
  -a, --app-name <name>
katax deploy rollback   # Revert commits
  -c, --commits <n>     # Default: 1
  -a, --app-name <name>
katax deploy logs       # View PM2 logs
  -l, --lines <n>
  -f, --follow
  -a, --app-name <name>
katax deploy status     # Show PM2 apps

# Default is cluster mode with max instances: pick 1 instance when using
# Socket.IO (needs sticky sessions) or the in-memory rate limiter.`}</code></pre>

          <h3>Fix</h3>
          <pre><code>{`katax fix docs        # Patch build script to copy openapi.json
  --skip-install
katax fix all         # Apply all fixes
  --skip-install
katax fix list        # List available patches`}</code></pre>

          <h3>Global Options</h3>
          <pre><code>{`--no-color     # Disable colored output
--verbose      # Enable verbose logging
-v, --version  # Show version`}</code></pre>

          <h3>Examples</h3>
          <pre><code>{`katax init my-api --pm pnpm --ignore-scripts --write-npmrc
katax add endpoint admin/audit/logs
katax generate crud admin/users --no-auth
katax generate repository products
katax generate docs -u https://api.example.com
katax deploy update -b production --hard`}</code></pre>
        </section>

        <!-- ── Generators / Templates ── -->
        <section id="cli-generators" class="doc-section">
          <div class="section-accent"></div>
          <h2><span class="section-icon">&#9679;</span> Generators &amp; Templates</h2>

          <div class="reference-grid">
            <article class="reference-card">
              <h4>Validator Generator</h4>
              <p><code>k.object()</code> schemas per field, <code>kataxInfer</code> types and <code>validate*()</code> functions built on <code>validateSchema()</code>.</p>
            </article>
            <article class="reference-card">
              <h4>Controller Generator</h4>
              <p>Business logic returning <code>ControllerResult&lt;T&gt;</code> via <code>createResponse.success()</code> / <code>createResponse.error()</code>.</p>
            </article>
            <article class="reference-card">
              <h4>Handler Generator</h4>
              <p>Express middleware chaining validator + controller with <code>sendResponse()</code>.</p>
            </article>
            <article class="reference-card">
              <h4>Route Generator</h4>
              <p>Express Router with method calls and JSDoc documentation.</p>
            </article>
            <article class="reference-card">
              <h4>Router Updater</h4>
              <p>Adds the import and <code>router.use()</code> to the main <code>routes.ts</code>. Prevents duplicates.</p>
            </article>
            <article class="reference-card">
              <h4>OpenAPI Generator</h4>
              <p>Scans validators and routes, generates OpenAPI 3.0 spec.</p>
            </article>
          </div>

          <h3>Shared Utilities</h3>
          <div class="reference-grid">
            <article class="reference-card">
              <h4>API Utils</h4>
              <ul>
                <li><code>ControllerResult&lt;T&gt;</code> type (with pagination and cookies)</li>
                <li><code>createResponse.success/error/validation/unauthorized/forbidden/custom</code></li>
                <li><code>createSuccessResult()</code> &middot; <code>createErrorResult()</code></li>
                <li><code>validateSchema()</code></li>
                <li><code>sendResponse()</code></li>
                <li><code>setCookie()</code> &middot; <code>clearCookie()</code></li>
              </ul>
            </article>
            <article class="reference-card">
              <h4>Stream Utils (SSE)</h4>
              <ul>
                <li><code>initSSE()</code> &middot; <code>sendSSEEvent()</code></li>
                <li><code>sendSSEComment()</code> &middot; <code>closeSSE()</code></li>
                <li><code>SSEStream</code> class (<code>send</code>, <code>sendError</code>, <code>close</code>, <code>isClosed</code>)</li>
                <li><code>sendChunked()</code> &middot; <code>streamAsyncIterator()</code> &middot; <code>streamArray()</code></li>
              </ul>
            </article>
            <article class="reference-card">
              <h4>Auth Utils</h4>
              <ul>
                <li><code>hashPassword()</code> &middot; <code>verifyPassword()</code> (bcryptjs)</li>
                <li><code>hashPasswordArgon2()</code> &middot; <code>verifyPasswordArgon2()</code></li>
                <li><code>generateToken()</code> &middot; <code>verifyToken()</code> &middot; <code>decodeToken()</code> &middot; <code>generateRefreshToken()</code> (JWT)</li>
                <li><code>generateRandomToken()</code> &middot; <code>generateNumericCode()</code></li>
                <li><code>sha256()</code> &middot; <code>md5()</code> &middot; <code>encrypt()</code> &middot; <code>decrypt()</code> &middot; <code>secureCompare()</code></li>
              </ul>
            </article>
          </div>

          <h3>JWT Middleware (<code>jwt.utils.ts</code>)</h3>
          <pre><code>{`import { authenticateToken, requireRole, generateTokens } from '../shared/jwt.utils.js';

router.get('/admin', authenticateToken, requireRole('admin'), handler);
const { accessToken, refreshToken } = generateTokens({ userId: user.id, email: user.email });`}</code></pre>
        </section>

